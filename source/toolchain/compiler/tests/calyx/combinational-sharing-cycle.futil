import "primitives/core.futil";
component main(value: 8) -> (first_result: 8, second_result: 8) {
  cells {
    first_sub = std_sub(8); second_sub = std_sub(8);
    first_xor = std_xor(8); second_xor = std_xor(8);
    first_out = std_reg(8); second_out = std_reg(8);
  }
  wires {
    first_result = first_out.out;
    second_result = second_out.out;
    group first {
      first_sub.left = value; first_sub.right = 8'd1;
      first_xor.left = first_sub.out; first_xor.right = 8'd3;
      first_out.in = first_xor.out; first_out.write_en = 1'd1;
      first[done] = first_out.done;
    }
    group second {
      second_xor.left = value; second_xor.right = 8'd3;
      second_sub.left = second_xor.out; second_sub.right = 8'd1;
      second_out.in = second_sub.out; second_out.write_en = 1'd1;
      second[done] = second_out.done;
    }
  }
  control { seq { first; second; } }
}
