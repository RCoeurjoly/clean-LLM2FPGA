+/// Lower guard-disjointness to bounded typed Verilog AST expressions.
+/// `$onehot0` counts known one bits (X/Z do not count). Each chunk must
+/// therefore be locally disjoint, and at most one chunk may contain a known
+/// one. `$countones(chunk) > 0` gives a known one-bit presence summary even
+/// when the original guards contain X/Z. Repeat on summaries to bound every
+/// concatenation, without changing the failure condition or dropping checks.
+fn lower_bounded_disjoint_check(mut guards: Vec<v::Expr>, names: &mut calyx_utils::NameGenerator) -> (Vec<(calyx_utils::Id, v::Expr)>, v::Expr) {
+    const MAX_GUARDS: usize = 128;
+    let mut wires = Vec::new();
+    let mut checks = Vec::new();
+    let mut share = |expr: v::Expr| {
+        let name = names.gen_name("_calyx_guard_check");
+        let reference = v::Expr::new_ref(name.to_string());
+        wires.push((name, expr));
+        reference
+    };
+    while guards.len() > MAX_GUARDS {
+        let mut summaries = Vec::with_capacity(guards.len().div_ceil(MAX_GUARDS));
+        for chunk in guards.chunks(MAX_GUARDS) {
+            let mut concat = v::ExprConcat::default();
+            for guard in chunk {
+                concat.add_expr(guard.clone());
+            }
+            let expression = v::Expr::Concat(concat);
+            checks.push(share(v::Expr::new_call("$onehot0", vec![expression.clone()])));
+            summaries.push(share(v::Expr::new_gt(
+                v::Expr::new_call("$countones", vec![expression]),
+                v::Expr::new_int(0),
+            )));
+        }
+        guards = summaries;
+    }
+    let mut concat = v::ExprConcat::default();
+    for guard in guards {
+        concat.add_expr(guard);
+    }
+    let final_check = v::Expr::new_call("$onehot0", vec![v::Expr::Concat(concat)]);
+    if checks.is_empty() { return (wires, final_check); }
+    checks.push(share(final_check));
+    // Balance the conjunction as well as bounding the vector operations.
+    while checks.len() > 1 {
+        let mut next = Vec::with_capacity(checks.len().div_ceil(2));
+        let mut iter = checks.into_iter();
+        while let Some(left) = iter.next() {
+            next.push(match iter.next() {
+                Some(right) => share(v::Expr::new_logical_and(left, right)),
+                None => left,
+            });
+        }
+        checks = next;
+    }
+    (wires, checks.pop().expect("a guard check contains a vector"))
+}
