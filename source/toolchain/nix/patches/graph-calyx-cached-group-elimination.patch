+// The deletion rule is unchanged; only the repeated control query is shared.
+class CachedEliminateUnusedCombGroups
+    : public mlir::OpRewritePattern<calyx::CombGroupOp> {
+public:
+  using OpRewritePattern::OpRewritePattern;
+
+  LogicalResult matchAndRewrite(calyx::CombGroupOp group,
+                               PatternRewriter &rewriter) const override {
+    auto component = group->getParentOfType<calyx::ComponentOp>();
+    if (!controlUses.isKnownUnused(component, group.getSymNameAttr()))
+      return failure();
+    rewriter.eraseOp(group);
+    return success();
+  }
+
+private:
+  ControlGroupUses controlUses;
+};
 
