-// BuildControl finishes before this pattern starts. This pattern changes only
-// wires, so control symbol uses remain immutable for its entire lifetime.
-// Keep the cache local to this pattern: no cross-pass or cross-module state.
+// Each consumer owns its own cache. BuildControl has finished, and neither
+// combinational inlining nor unused-group elimination changes control uses.
+class ControlGroupUses {
+public:
+  bool isKnownUnused(calyx::ComponentOp component, StringAttr name) const {
+    auto found = users.find(component.getOperation());
+    if (found == users.end()) {
+      std::optional<llvm::DenseSet<StringAttr>> names;
+      // ControlOp is a symbol table: query its body to visit the schedule.
+      auto uses = SymbolTable::getSymbolUses(
+          &component.getControlOp()->getRegion(0));
+      if (uses) {
+        names.emplace();
+        for (const auto &use : *uses)
+          names->insert(use.getSymbolRef().getRootReference());
+      }
+      found = users.try_emplace(component.getOperation(), std::move(names)).first;
+    }
+    // Preserve conservative behavior for unknown symbol-table operations.
+    return found->second && !found->second->contains(name);
+  }
+
+private:
+  mutable llvm::DenseMap<Operation *,
+                        std::optional<llvm::DenseSet<StringAttr>>> users;
+};
