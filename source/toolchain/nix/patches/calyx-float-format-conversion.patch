+  LogicalResult buildRegisteredFloatOp(PatternRewriter &rewriter, Operation *op) const {
+    auto loc = op->getLoc();
+    if (auto cast = dyn_cast<TruncFOp>(op))
+      if (cast.getRoundingmode().value_or(arith::RoundingMode::to_nearest_even) !=
+          arith::RoundingMode::to_nearest_even)
+        return op->emitError("unsupported floating-point rounding mode");
+    unsigned from = op->getOperand(0).getType().getIntOrFloatBitWidth();
+    unsigned to = op->getResult(0).getType().getIntOrFloatBitWidth();
+    bool fma = isa<math::FmaOp>(op);
+    if (fma ? (from != 32 && from != 64) :
+        !((from == 32 && to == 64) || (from == 64 && to == 32)))
+      return op->emitError("floating primitive supports only f32 and f64");
+    unsigned count = op->getNumOperands(), outIndex = 3 + count, doneIndex = outIndex + 1;
+    std::string name = fma ? "std_float_fma_" + std::to_string(from) :
+        "std_float_cast_" + std::to_string(from) + "_" + std::to_string(to);
+    std::string source = floatCastSource.getValue();
+    if (fma) source = StringRef(source).rsplit('/').first.str() + "/float_fma.sv";
+    auto component = getComponent();
+    auto module = component->getParentOfType<ModuleOp>();
+    auto one = rewriter.getI1Type();
+    auto input = rewriter.getIntegerType(from), output = rewriter.getIntegerType(to);
+    if (!SymbolTable::lookupSymbolIn(module, name)) {
+      OpBuilder::InsertionGuard guard(rewriter);
+      rewriter.setInsertionPointToStart(module.getBody());
+      SmallVector<hw::PortInfo> ports;
+      auto port = [&](StringRef name, Type type, hw::ModulePort::Direction dir,
+                      StringRef flag = {}) {
+        hw::PortInfo p;
+        p.name = rewriter.getStringAttr(name);
+        p.type = type;
+        p.dir = dir;
+        p.argNum = ports.size();
+        p.loc = loc;
+        NamedAttrList attributes;
+        if (!flag.empty()) attributes.set(flag, rewriter.getI64IntegerAttr(1));
+        if (name == "go") attributes.set("calyx.interval", rewriter.getI64IntegerAttr(1));
+        p.attrs = attributes.getDictionary(rewriter.getContext());
+        ports.push_back(p);
+      };
+      using Direction = hw::ModulePort::Direction;
+      port("clk", one, Direction::Input, "calyx.clk");
+      port("reset", one, Direction::Input, "calyx.reset");
+      port("go", one, Direction::Input, "calyx.go");
+      for (unsigned i = 0; i < count; ++i)
+        port(fma ? "in" + std::to_string(i) : "in", input, Direction::Input);
+      port("out", output, Direction::Output);
+      port("done", one, Direction::Output, "calyx.done");
+      auto declaration = hw::HWModuleExternOp::create(rewriter, loc,
+          rewriter.getStringAttr(name), ports, StringRef(), rewriter.getArrayAttr({}));
+      declaration->setAttr("filename", rewriter.getStringAttr(source));
+    }
+    rewriter.setInsertionPointToStart(component.getBodyBlock());
+    auto &state = getState<ComponentLoweringState>();
+    SmallVector<Type> types{one, one, one};
+    types.append(count, input);
+    types.push_back(output);
+    types.push_back(one);
+    auto primitive = calyx::PrimitiveOp::create(rewriter, loc,
+        types, state.getUniqueName("float"), rewriter.getArrayAttr({}), name);
+    auto reg = createRegister(loc, rewriter, component, to, state.getUniqueName("cast_result"));
+    auto high = createConstant(loc, rewriter, component, 1, 1);
+    auto group = createGroupForOp<calyx::GroupOp>(rewriter, op);
+    state.addBlockScheduleable(op->getBlock(), group);
+    state.registerEvaluatingGroup(primitive.getResult(outIndex), group);
+    state.registerEvaluatingGroup(primitive.getResult(doneIndex), group);
+    OpBuilder builder(group->getRegion(0));
+    rewriter.setInsertionPointToEnd(group.getBodyBlock());
+    auto done = primitive.getResult(doneIndex);
+    for (unsigned i = 0; i < count; ++i)
+      calyx::AssignOp::create(rewriter, loc, primitive.getResult(3 + i), op->getOperand(i));
+    calyx::AssignOp::create(rewriter, loc, primitive.getResult(2), high,
+        comb::createOrFoldNot(builder, loc, done));
+    calyx::AssignOp::create(rewriter, loc, reg.getIn(), primitive.getResult(outIndex));
+    calyx::AssignOp::create(rewriter, loc, reg.getWriteEn(), done);
+    calyx::GroupDoneOp::create(rewriter, loc, reg.getDone());
+    op->getResult(0).replaceAllUsesWith(reg.getOut());
     return success();
   }

