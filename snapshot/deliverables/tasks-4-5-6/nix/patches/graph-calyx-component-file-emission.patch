+fn component_output_directory(ctx: &ir::Context) -> CalyxResult<Option<PathBuf>> {
+    let options: Vec<_> = ctx.extra_opts.iter()
+        .filter_map(|value| value.strip_prefix("verilog-component-dir="))
+        .collect();
+    if options.len() > 1 || options.first().is_some_and(|value| value.is_empty()) {
+        return Err(Error::write_error("invalid verilog-component-dir option".to_string()));
+    }
+    Ok(options.first().map(|value| PathBuf::from(value)))
+}
