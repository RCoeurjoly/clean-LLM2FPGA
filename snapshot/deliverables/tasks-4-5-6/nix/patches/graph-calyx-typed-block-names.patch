+// Supported source regions use MLIR's default block names. Obtain that ordinal
+// from typed IR, without constructing an AsmState for the unfinished module.
+static std::string sourceBlockName(Block *block) {
+  auto ordinal = std::distance(block->getParent()->begin(), block->getIterator());
+  return "bb" + std::to_string(ordinal);
+}
