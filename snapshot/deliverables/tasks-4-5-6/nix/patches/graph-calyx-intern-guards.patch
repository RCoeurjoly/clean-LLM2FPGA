+/// Exact structural interning shares typed nodes, without Boolean rewrites or
+/// reordering operands. Canonical ports are scoped to this component's pool.
+pub struct GuardPool(Vec<FlatGuard>, HashMap<GuardKey, GuardRef>);
+
+#[derive(PartialEq, Eq, Hash)]
+enum GuardKey {
+    Or(u32, u32),
+    And(u32, u32),
+    Not(u32),
+    Comp(u8, Canonical, Canonical),
+    Port(Canonical),
+}
+
+impl GuardKey {
+    fn from_guard(guard: &FlatGuard) -> Self {
+        match guard {
+            FlatGuard::Or(left, right) => Self::Or(left.index(), right.index()),
+            FlatGuard::And(left, right) => Self::And(left.index(), right.index()),
+            FlatGuard::Not(child) => Self::Not(child.index()),
+            FlatGuard::CompOp(op, left, right) => {
+                let opcode = match op {
+                    PortComp::Eq => 0, PortComp::Neq => 1,
+                    PortComp::Lt => 2, PortComp::Leq => 3,
+                    PortComp::Gt => 4, PortComp::Geq => 5,
+                };
+                Self::Comp(opcode, left.borrow().canonical(), right.borrow().canonical())
+            }
+            FlatGuard::Port(port) => Self::Port(port.borrow().canonical()),
+            FlatGuard::True => unreachable!("true is the pool's reserved first node"),
+        }
+    }
+}
 
